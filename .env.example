# Arcanis: copy to .env at the repo root and fill in. Never commit .env.

# Database (MySQL). Tests use TEST_DATABASE_URL and refuse to run against DATABASE_URL.
DATABASE_URL=mysql://user:password@host:4000/arcanis
TEST_DATABASE_URL=mysql://user:password@host:4000/arcanis_test

# Sessions
JWT_SECRET=

# Text model (Layer 1 and Layer 2c). Providers: groq, gemini, openrouter
SPELL_LLM_PROVIDER=groq
SPELL_LLM_API_KEY=
SPELL_LLM_FALLBACK_PROVIDERS=gemini,openrouter
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Image model (Hugging Face router, FLUX)
IMAGE_PROVIDER=huggingface
IMAGE_GEN_API_KEY=

# Moderation (Layer 2b). Providers: openai
MODERATION_PROVIDER=openai
OPENAI_API_KEY=

# Object storage. Providers: cloudinary (soft launch), r2 (Phase 1b)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (magic link and code). Providers: resend, brevo
EMAIL_PROVIDER=brevo
RESEND_API_KEY=
RESEND_FROM=Arcanis <no-reply@example.com>
BREVO_API_KEY=
BREVO_FROM=Arcanis <no-reply@example.com>

# Spend protection (Build Plan 7.7)
DAILY_SPEND_LIMIT_USD=2
DAILY_CREATION_LIMIT=50
FOUNDER_ALERT_EMAIL=

# Server
PORT=3100
FRONTEND_URL=http://localhost:3100
CORS_ALLOWED_ORIGINS=
# Proxies in front of the API: 1 on Render alone, 2 behind the Vercel rewrite.
TRUST_PROXY_HOPS=1

# Client (Vite). The API is always same-origin /api (Vercel rewrite).
VITE_PUBLIC_URL=
# 1 = live check of every configured model when the dev server starts (calls real LLMs; off by default)
MODEL_CHECK_ON_START=
