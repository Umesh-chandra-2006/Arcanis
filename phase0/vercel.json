{
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://RENDER_API_ORIGIN/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://RENDER_API_ORIGIN/health"
    },
    {
      "source": "/spell/:id/image",
      "destination": "https://RENDER_API_ORIGIN/spell/:id/image"
    },
    {
      "source": "/spell/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebookcatalog|twitterbot|discordbot|slackbot|whatsapp|telegrambot|linkedinbot|embedly|pinterest|redditbot|skypeuripreview|vkshare|quora link preview|applebot|google-inspectiontool|iframely).*"
        }
      ],
      "destination": "https://RENDER_API_ORIGIN/spell/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
