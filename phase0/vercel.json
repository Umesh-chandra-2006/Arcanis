{
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://res.cloudinary.com; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://arcanis-jpm1.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://arcanis-jpm1.onrender.com/health"
    },
    {
      "source": "/spell/:id/image",
      "destination": "https://arcanis-jpm1.onrender.com/spell/:id/image"
    },
    {
      "source": "/spell/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebookcatalog|twitterbot|discordbot|slackbot|whatsapp|telegrambot|linkedinbot|embedly|pinterest|redditbot|skypeuripreview|vkshare|quora link preview|applebot|google-inspectiontool|iframely).*"
        }
      ],
      "destination": "https://arcanis-jpm1.onrender.com/spell/:id"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/signin",
      "destination": "/index.html"
    },
    {
      "source": "/auth/verify",
      "destination": "/index.html"
    },
    {
      "source": "/sanctum",
      "destination": "/index.html"
    },
    {
      "source": "/create",
      "destination": "/index.html"
    },
    {
      "source": "/library",
      "destination": "/index.html"
    },
    {
      "source": "/codex",
      "destination": "/index.html"
    },
    {
      "source": "/spell/:id",
      "destination": "/index.html"
    },
    {
      "source": "/s/:id",
      "destination": "/index.html"
    },
    {
      "source": "/reviews",
      "destination": "/index.html"
    },
    {
      "source": "/feedback",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/admin/metrics",
      "destination": "/index.html"
    },
    {
      "source": "/admin/moderation",
      "destination": "/index.html"
    },
    {
      "source": "/admin/feedback",
      "destination": "/index.html"
    }
  ]
}
